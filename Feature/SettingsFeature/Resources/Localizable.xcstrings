      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose “System” to follow your iPad's light or dark setting. The paper area with the text and your writing stays bright even in dark mode."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「시스템 설정」을 고르면 iPad의 라이트·다크 설정을 따라가요. 원문과 필기가 있는 종이 영역은 다크 모드에서도 밝게 보여요."
          }
        }
      }
