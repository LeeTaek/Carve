      }
    },
    "%@에서 「손가락 필사 허용」을 켜면 손가락으로도 필사할 수 있어요. 이때는 두 손가락으로 스크롤해요." : {
      "comment" : "설정 › 도움말 — 형식 문자열(%lld 는 수, %@ 는 문구)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on “Allow finger writing” in %@ to write with your finger, too. Then scroll with two fingers."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 「손가락 필사 허용」을 켜면 손가락으로도 필사할 수 있어요. 이때는 두 손가락으로 스크롤해요."
          }
        }
      }
    },
    "%@에서 바꿔요." : {
